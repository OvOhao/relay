{
  "name": "relay",
  "productName": "Relay",
  "version": "0.1.0",
  "description": "Use several of your own Claude accounts from one Claude Code window: hand heavy jobs to your other accounts, with shared memory and usage at a glance. A macOS fork of Baton.",
  "author": { "name": "OvOhao", "url": "https://github.com/OvOhao" },
  "contributors": [{ "name": "ZhengGao-30", "url": "https://github.com/ZhengGao-30", "role": "author of Baton, which Relay is based on" }],
  "homepage": "https://github.com/OvOhao/relay#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OvOhao/relay.git"
  },
  "bugs": {
    "url": "https://github.com/OvOhao/relay/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "electron",
    "tray-app",
    "accounts",
    "usage-limits"
  ],
  "main": "src/main.js",
  "bin": {
    "relay": "src/cli.js"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "node src/dev.js",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.relay.app",
    "productName": "Relay",
    "copyright": "Copyright (c) 2026 ZhengGao-30, OvOhao",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "src/**",
      "ui/**",
      "build/icon.png",
      "build/icon.ico",
      "build/tray.png",
      "package.json",
      "build/trayTemplate.png",
      "build/trayTemplate@2x.png"
    ],
    "icon": "build/icon.png",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Relay",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "artifactName": "Relay-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Relay-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "darkModeSupport": true,
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Relay-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "LSUIElement": true,
        "NSHumanReadableCopyright": "Copyright (c) 2026 ZhengGao-30, OvOhao"
      }
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "asar": false,
    "dmg": {
      "artifactName": "Relay-${version}-${arch}.${ext}"
    }
  }
}
